{
  "project": "titanic",
  "target": "Survived",
  "drop_columns": [
    "PassengerId",
    "Name",
    "Ticket",
    "Cabin",
    "SibSp",
    "Parch"
  ],
  "preprocessing": {
    "Fare": {
      "strategy": "log1p",
      "note": "skewness 4.79→0.39"
    },
    "Age": {
      "strategy": "group_median_impute",
      "group_by": [
        "Pclass",
        "Sex"
      ],
      "note": "19.9% 결측"
    },
    "Cabin": {
      "strategy": "binary_flag",
      "new_column": "HasCabin",
      "note": "77.1% 결측, Pclass 통제 후에도 유의미"
    },
    "Embarked": {
      "strategy": "mode_impute_and_onehot",
      "impute_value": "S",
      "note": "2건 결측"
    },
    "Sex": {
      "strategy": "binary_encode",
      "mapping": {
        "male": 1,
        "female": 0
      }
    },
    "SibSp_Parch": {
      "strategy": "combine",
      "new_column": "FamilySize",
      "formula": "SibSp+Parch+1",
      "note": "2~4인 최적, 5+ 급락"
    }
  },
  "scaling": "모델에 따라 결정"
}