{
  "project": "titanic",
  "target": "Survived",
  "drop_columns": [
    "PassengerId",
    "Name",
    "Ticket",
    "Cabin",
    "SibSp",
    "Parch"
  ],
  "preprocessing": {
    "Fare": {
      "strategy": "log1p",
      "note": "skewness 4.79→0.39로 감소. Fare=0 (15건)은 그대로 유지"
    },
    "Age": {
      "strategy": "group_median_impute",
      "group_by": [
        "Pclass",
        "Sex"
      ],
      "note": "19.9% 결측, Pclass·Sex 그룹별 중앙값 대체"
    },
    "Cabin": {
      "strategy": "binary_flag",
      "new_column": "HasCabin",
      "note": "77.1% 결측. 결측 여부가 Pclass 통제 후에도 Survived와 상관. 원본 drop"
    },
    "Embarked": {
      "strategy": "mode_impute_and_onehot",
      "impute_value": "S",
      "note": "2건 결측 → 최빈값(S) 대체, 원핫 인코딩"
    },
    "Sex": {
      "strategy": "binary_encode",
      "mapping": {
        "male": 1,
        "female": 0
      }
    },
    "SibSp_Parch": {
      "strategy": "combine",
      "new_column": "FamilySize",
      "formula": "SibSp + Parch + 1",
      "note": "2~4인 가족 생존율 최고(55~72%), 5+ 급락. 구간화는 모델링 단계에서 실험"
    }
  },
  "scaling": "모델에 따라 결정 (트리 기반: 불필요, 선형 모델: StandardScaler)"
}